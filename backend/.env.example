PORT=5000
NODE_ENV=development
JWT_SECRET=your_mandatory_jwt_secret_key_here
JWT_EXPIRES_IN=7d
CORS_ORIGIN=*
LOG_LEVEL=info
BCRYPT_SALT_ROUNDS=10

# API Documentation (Swagger UI at /api-docs)
# Defaults to enabled in development/test, and disabled in production for security.
# Set to 'true' in production to allow technical assessment evaluators to test live endpoints.
ENABLE_SWAGGER=true

# Financial & Wallet settings
DEFAULT_CURRENCY=NGN
DEFAULT_INITIAL_WALLET_BALANCE=3000000.28

# Demo User Settings (Figma persona)
DEMO_USER_EMAIL=bunmi@securebypay.com
DEMO_USER_PASSWORD=Password123!
DEMO_USER_FIRST_NAME=Bunmi
DEMO_USER_LAST_NAME=Tanny
DEMO_USER_PHONE=+2348012345678

# Primary local MongoDB connections (preferred)
MONGO_URI=mongodb://127.0.0.1:27017/securebypay?directConnection=true
MONGO_TEST_URI=mongodb://127.0.0.1:27017/securebypay_test?directConnection=true

# Cloud MongoDB Atlas fallbacks
MONGO_FALLBACK_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/securebypay?retryWrites=true&w=majority
MONGO_TEST_FALLBACK_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/securebypay_test?retryWrites=true&w=majority
